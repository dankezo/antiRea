{
  "name": "@dannyphan190/anti-rea",
  "version": "2.7.0",
  "private": false,
  "description": "Evidence-led web anti-cloning toolkit: server-side quota/pagination guards, Web Bot Auth (RFC 9421) signed-agent verification, canary traps, a Python/FastAPI quota-guard port, controlled twin-SaaS benchmark and REA envelope guidance.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "README.md",
    "README.vi.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "check": "npm run test && node scripts/run-audit.cjs",
    "prepack": "npm run build",
    "benchmark:build-sdk": "tsc -p benchmark/tsconfig.browser.json",
    "benchmark:demo": "node benchmark/demo/server.cjs --mode protected --port 4174",
    "benchmark:baseline": "node benchmark/demo/server.cjs --mode baseline --port 4173",
    "benchmark:browser": "python benchmark/run_browser.py",
    "benchmark:report": "python benchmark/report.py",
    "benchmark:all": "python benchmark/run_all.py"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "web-security",
    "reverse-engineering",
    "anti-scraping",
    "rate-limiting",
    "saas-security",
    "source-map",
    "canary",
    "watermark",
    "ai-agents",
    "browser-automation",
    "web-bot-auth",
    "rfc-9421",
    "http-message-signatures",
    "ed25519",
    "fastapi"
  ],
  "author": "Danny Phan <dannyphan190@gmail.com>",
  "license": "MIT",
  "funding": {
    "type": "paypal",
    "url": "https://www.paypal.com/paypalme/dannyphan190"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dankezo/antiRea.git"
  },
  "homepage": "https://github.com/dankezo/antiRea#readme",
  "bugs": {
    "url": "https://github.com/dankezo/antiRea/issues"
  }
}
